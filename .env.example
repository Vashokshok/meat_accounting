# Copy to .env, then set a unique database password and random secret:
# openssl rand -hex 32
POSTGRES_USER=meat
POSTGRES_PASSWORD=
POSTGRES_DB=meat

# Required for local runs; Docker Compose supplies its own internal DB URL.
DATABASE_URL=postgresql+asyncpg://meat:@localhost:5432/meat
SECRET_KEY=

APP_PORT=8000
ACCESS_TOKEN_EXPIRE_HOURS=24
TIMEZONE=Europe/Moscow
ALLOWED_ORIGINS=https://meat-uchet.ru,https://www.meat-uchet.ru
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
